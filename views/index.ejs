          <button id="modalBtn" class="m-5 bg-gray-200 h-15 rounded-xl border-none active:bg-amber-500 cursor-pointer transition-colors">+ New</button>
          <dialog id="modal" class="max-w-screen max-h-screen rounded-lg border-none">
            <div class="w-full h-full flex justify-center items-center">
              <button id="close-modal-btn" class="w-20 h-10">x</button>
            </div>
          </dialog>
          <div class="ml-5 mr-5 mb-5 h-full flex flex-col justify-start items-center ">
            <div class="w-full relative inline-block">
              <button id="dropdownBtn" class="h-5 w-full flex justify-start items-center cursor-pointer focus:outline-none bg-gray-100 border-none">
                <img id="dropdownIcon" class="w-4 h-4 rotate-270 transform transition-transform duration-300" src="/images/down.png" alt="arrow bracket">
                <div>john</div>
              </button>
              <div id="dropdownMenu" class="w-full absolute right-0 origin-top transition-all duration-200 ease-in-out opacity-0 scale-y-0 pointer-events-none bg-gray-50 flex-col z-10">
