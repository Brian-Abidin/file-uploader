<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body class="m-0 p-0">
  <% if (locals.user) {%>
    <h1>WELCOME BACK <%= user.username %></h1>
    <a href="/log-out">LOG OUT</a>
  <% } else { %>
    <div class="h-screen w-screen flex justify-center items-center bg-gray-700">
      <form class="h-60 w-60 p-5 flex flex-col justify-center items-center rounded-2xl bg-amber-400" action="/log-in" method="POST">
        <div class="m-0 p-0 w-full flex flex-col bg-amber-600">
          <h2 class="m-0 p-0">File Uploader</h2>
          <h4 class="m-0 p-0">don't have an account?<a href="/sign-up">Sign Up!</a></h4>
        </div>
        <div class="w-full flex flex-col justify-center items-center gap-2 bg-blue-300">
          <div class="w-full">
            <label for="username">Username</label>
            <input class="m-0 p-0 w-full flex h-8 border-0" id="username" name="username" placeholder="username" type="text" />
          </div>
          <div class="w-full">
            <label for="password">Password</label>
            <input class="m-0 p-0 w-full flex h-8 border-0" id="password" name="password" placeholder="password" type="password" />
          </div>
          <div class="w-full">
            <label for="confirm-password">Confirm Password:</label>
            <input class="m-0 p-0 w-full flex h-8 border-0" id="confirm-password" name="confirm-password" placeholder="confirm password" type="password">
          </div>
          <button class="w-full" type="submit">Log In</button>
        </div>
      </form>
    </div>
  <%}%>

</body>
</html>