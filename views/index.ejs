<!DOCTYPE html>
<html lang="en">
<%- include('partials/head') %>
<body class="font-sans m-0 p-0 ">
  <div class="h-screen w-screen grid grid-col-1 grid-rows-[auto_1fr] bg-amber-400">
    <%- include('partials/header') %>
    <% if (locals.user) {%>
      <h1>WELCOME BACK <%= user.username %></h1>
      <a href="/log-out">LOG OUT</a>
    <% } else { %>
      <div class="flex justify-start items-start bg-gray-800 text-gray-50">
        <div class="w-55 h-full flex flex-col bg-gray-800">
          <div class="m-5 h-full flex flex-col justify-start items-center">
            <div>This is where the file options are</div>
          </div>
        </div>
        <div class="mr-5 flex-1 min-w-150 h-[98%] bg-gray-700 rounded-2xl">
          <div class="m-5">This is where the files are going to be located in rows</div>
        </div>
      </div>
    <%}%>
  </div>
  

</body>
</html>