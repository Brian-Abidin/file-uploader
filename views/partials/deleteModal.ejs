<!-- delete folder modal -->
<dialog id="delete-modal" class="delete-modal max-w-screen max-h-screen inset-0 p-2 m-auto rounded-md backdrop:bg-gray-950/50">
  <div class="w-full h-full flex flex-col items-center">
    <!-- upper content -->
    <div class="w-full h-5 flex items-center justify-end">
      <button id="close-delete-modal" class="close-delete-modal-btn h-5 w-8 flex justify-center items-center bg-gray-500 rounded-md hover:cursor-pointer">x</button>
    </div>
    <!-- middle content -->
    <div class="h-fit flex flex-col flex-1 justify-center items-center ">
      <% if(files[i].type === "FOLDER"){ %>
        <div class="mb-2 text-2xl">Deleting the following folder:</div>
        <div class="w-full flex justify-center items-center">Deleting a folder will also delete all the content inside.</div>
        <% } else { %>
          <div class="mb-2 text-2xl">Deleting the following file:</div>
        <% }%>
        <div id="data-container" class="text-lg">
          ID:<div id="file-id" class="file-id"><%=files[i].id %></div>
          Name: <%= files[i].name %><br>
          Size: <%= (files[i].size / (1024 * 1024)).toFixed(2) %> MB
        </div>
      </div>
    <!-- bottom content -->
    <div class="w-full h-fit flex justify-between items-center ">
      <button class="decline-delete-btn p-1 w-fit bg-gray-600 rounded-md text-gray-50 hover:cursor-pointer">No</button>
      <button class="confirm-delete-btn p-1 w-fit bg-gray-600 rounded-md text-gray-50 hover:cursor-pointer">Yes</button>
    </div>
  </div>
</dialog>