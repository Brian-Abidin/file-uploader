<!DOCTYPE html>
<html lang="en">
  <%- include('partials/head') %>
  <body>
    <div class="min-h-screen min-w-screen grid grid-col-1 grid-rows-[auto_1fr] bg-gray-800">
      <%- include('partials/publicHeader') %>
      <div class="ml-2 mr-2 mb-2 flex justify-start items-start bg-gray-800 text-gray-50">
        <!-- Right side content showing directory and table -->
        <div class="h-full w-full flex-col flex-5 justify-center items-center bg-gray-700 rounded-xl">
          <div class="m-4 flex flex-col justify-center items-center ">
            <!-- previous directory and current directory -->
            <div class="w-full flex flex-col justify-center items-center">
              <h2>This is a public shared link that will expire in <%= minutes %> <% if(minutes > 2){ %>
                minutes.
              <% } else { %>
                minute.
              <%}%>
              </h2>
              <h2>Only files inside a folder will be shared.</h2>
            </div>
            <div class="ml-1 h-15 max-w-175 flex self-start items-center overflow-x-auto whitespace-nowrap text-xl gap-2">
              <div>Current Directory: <%= parentName %></div>
            </div>
            <div class="grid grid-cols-1 grid-rows-1 w-full">
              <!-- table headers -->
              <div class="grid grid-cols-[100px_1fr_1fr_100px_50px] place-items-center border-b border-gray-400">
                <div class="pl-2 w-full h-5 flex justify-start items-center text-gray-950 bg-gray-300"><h5 class="h-fit text-sm">Type</h5></div>
                <div class="pl-2 w-full h-5 flex justify-start items-center text-gray-950 bg-gray-300"><h5 class="h-fit text-sm">Name</h5></div>
                <div class="pl-2 w-full h-5 flex justify-start items-center text-gray-950 bg-gray-300"><h5 class="h-fit text-sm">Date</h5></div>
                <div class="pl-2 w-full h-5 flex justify-start items-center text-gray-950 bg-gray-300"><h5 class="h-fit text-sm">Size</h5></div>
                <div class="pl-2 w-full h-5 flex justify-start items-center text-gray-950 bg-gray-300"><h5 class="h-fit text-sm"></h5></div>
              </div>
              <!-- loops through all files in database -->
              <% for(let i = 0; i < files.length; i++ ) { %>
                <div class="h-10 relative grid grid-cols-[100px_1fr_1fr_100px_50px] place-items-center border-b border-gray-400 text-sm gap-0.5">
                  <div class="pl-2 w-full flex items-center justify-start"><%= files[i].type %></div>
                  <div  class="pl-2 w-full flex items-center justify-start text-nowrap overflow-auto scrollbar-thin scrollbar-thumb-gray-800 scrollbar-track-transparent"><%= files[i].name %></div>
                  <div  class="pl-2 w-full flex items-center justify-start text-nowrap overflow-auto scrollbar-thin scrollbar-thumb-gray-800 scrollbar-track-transparent">FIX THIS</div>
                  <div  class="pl-2 w-full flex items-center justify-start "><%= files[i].size %> MB</div>
                  <!-- file options -->
                    <nav class="w-fit flex items-center justify-start" aria-label="Folder Options">
                      <div class="w-full dropdown-folder relative inline-block">
                        <button aria-haspopup="true" aria-expanded="false" aria-controls="dropdown-menu" class="flex justify-center items-center hover:cursor-pointer">
                          <img src="/images/menu.png" class="dropdown-toggle-folder w-7 hover:bg-gray-50 rounded-lg" alt="vertical 3 dots menu icon">
                        </button>
                        <% if(files[i].type === "FOLDER") { %>
                          <div class="dropdown-menu-folder absolute top-full w-40 right-0 left-auto mt-1 bg-gray-50 text-gray-950 list-none p-2 z-10 pointer-events-none opacity-0 scale-95 transition-all duration-150">
                            <!-- Option to edit folder name-->
                            <button class="open-edit-folder-btn mb-1 w-full hover:text-gray-950 hover:bg-gray-200">Edit Folder</button>
                            <!-- Option to delete folder-->
                            <button class="delete-folder-btn w-full hover:text-gray-950 hover:bg-gray-200" href="/">Delete Folder</button>
                          </div>
                          <% } else { %>
                          <div class="dropdown-menu-folder absolute top-full w-40 right-0 left-auto mt-1 bg-gray-50 text-gray-950 list-none p-2 z-10 pointer-events-none opacity-0 scale-95 transition-all duration-150">
                            <!-- download form -->
                            <%- include('partials/downloadForm.ejs', {files, i}) %>
                            <!-- Option to delete folder-->
                            <button class="delete-folder-btn w-full hover:text-gray-950 hover:bg-gray-200" href="/">Delete File</button>
                          </div>
                        <% } %>
                      </div>
                    </nav>
                  <%- include('partials/editModal.ejs', {files, i}) %>
                  <%- include('partials/deleteModal.ejs', {files, i}) %>
                </div>              
              <%} %>              
            </div>
          </div>
        </div>
      </div>
    </div>
    <script src="/js/index.js" defer></script>
  </body>
</html>